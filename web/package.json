{
  "name": "hk-eli-chatbot-web",
  "version": "0.1.0",
  "description": "HK ELI Chatbot front end (Angular 21). *Will be part of Ask-MIRA in future.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "export-seed": "esbuild scripts/export-seed.ts --bundle --platform=node --format=esm --outfile=scripts/.export-seed.mjs --log-level=warning && node scripts/.export-seed.mjs",
    "export-golden": "esbuild scripts/export-golden.ts --bundle --platform=node --format=esm --outfile=scripts/.export-golden.mjs --tsconfig=tsconfig.json --log-level=warning && node scripts/.export-golden.mjs",
    "start:gateway": "ng serve --configuration gateway"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@fontsource-variable/open-sans": "5.3.0",
    "lucide-static": "1.51.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "28.1.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "piscina": "5.3.2"
  }
}
