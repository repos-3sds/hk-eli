# HK ELI Chatbot settings. Copy to .env in the project folder and fill in the office values.
# Never commit or zip the filled .env. Secrets: prefer <NAME>_FILE pointing at a file your vault agent
# renders (for example /path/to/vault/secrets/tableau_secret); the file wins over the plain variable.
# Placeholders look like <...>. Leave a line commented out to keep its default.

# --- service ---------------------------------------------------------------
# Listen address. Must stay 127.0.0.1: the Java edge calls this service on the same machine.
HOST=127.0.0.1
# Port (1024-65535).
PORT=8050
# debug | info | warning | error
LOG_LEVEL=info
# Business time zone for "today" and maturity windows.
APP_TIMEZONE=Asia/Hong_Kong
# Fixed business date for demos (YYYY-MM-DD). Defaults to 2026-11-19 in mock mode; leave empty in real mode.
# DEMO_TODAY=2026-11-19
# SQLite file for conversations, answers, model-call audit and feedback (created on first start; never shipped).
DB_PATH=var/hkeli.sqlite
# Production store: MariaDB instead of the SQLite file above. Leave DB_URL unset on the laptop.
# The password comes from DB_PASSWORD_FILE (the file the Vault agent renders), or DB_PASSWORD.
# DB_URL=mariadb://hkeli_app@127.0.0.1:3306/hkeli
# DB_PASSWORD_FILE=/vault/secrets/hkeli_db

# --- identity (Java edge) -----------------------------------------------------
# true only behind the edge: then every call needs X-Edge-Token and X-Eli-User.
TRUST_EDGE_HEADERS=false
# Shared secret the edge sends as X-Edge-Token. Secret: use the _FILE form.
# EDGE_SHARED_TOKEN_FILE=<path-to-vault-rendered-file>
# User for calls when TRUST_EDGE_HEADERS=false (laptop demo).
DEFAULT_USER=demo.user

# --- Tableau ------------------------------------------------------------------
# mock (built-in synthetic workbook, no network) | real (the office Tableau server)
TABLEAU_MODE=mock
# How an answer shows the Tableau view: embed (live view in the side pane) | link (open on the server) | off
# Open decision: own charts + link, or live embed. Both work; pick per office check C11.
TABLEAU_EMBED=embed
# Seconds before a Tableau call gives up.
TABLEAU_TIMEOUT_S=30
# Real mode only:
# TABLEAU_SERVER=https://<tableau-server>
# TABLEAU_SITE=<site-content-url>
# TABLEAU_CLIENT_ID=<connected-app-client-id>
# TABLEAU_SECRET_ID_FILE=<path-to-vault-rendered-file>
# TABLEAU_SECRET_VALUE_FILE=<path-to-vault-rendered-file>
# Tableau user for demo calls without the edge (behind the edge, each user's own name is used).
# TABLEAU_USER=<tableau-username>
# TABLEAU_WORKBOOK=HK_ELI
# Which view contract the workbook follows: current (as today) | proposed (with W1-W7)
# TABLEAU_CATALOG=current
# TABLEAU_API_VERSION=3.22
# TABLEAU_EMBED_SCRIPT=/javascripts/api/tableau.embedding.3.latest.min.js
# vf_ keys use the view's captions (1) or field names (0): office check C1 decides.
# TABLEAU_VF_USE_CAPTIONS=1

# --- model gateway (Gemini) ---------------------------------------------------
# off (rules + templates, no model) | gateway (the office's approved model gateway)
LLM_MODE=off
# LLM_GATEWAY_URL=https://<model-gateway-host>
# Path appended to the URL; {model} is replaced. Check the gateway's own path (office check C12).
# LLM_GATEWAY_PATH=/v1/models/{model}:generateContent
# LLM_MODEL=gemini-2.5-flash
# Secret: use the _FILE form.
# LLM_API_KEY_FILE=<path-to-vault-rendered-file>
# Header and scheme the gateway expects for the key (sent as "<scheme> <key>").
# An empty scheme (LLM_AUTH_SCHEME=) sends the key alone, e.g. LLM_AUTH_HEADER=x-goog-api-key.
# LLM_AUTH_HEADER=Authorization
# LLM_AUTH_SCHEME=Bearer
# Name shown in answers as meta.provider.
# LLM_PROVIDER_LABEL=Gemini
# LLM_TIMEOUT_S=20
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0
# Office root certificate for TLS inspection (never turn verification off).
# LLM_CA_BUNDLE=<path-to-office-root-ca.pem>

# --- content (defaults are the shipped folders) ----------------------------------
# KNOWLEDGE_DIR=hkeli_poc/knowledge
# PROMPTS_DIR=hkeli_poc/prompts
# Semantic catalog. Office: the merged copy written by office/import_catalog.py (never zipped or committed).
# CATALOG_PATH=var/catalog-office.json
# Concept matcher and value translation over the catalog (true | false). false = regex pre-parse only.
# CONCEPT_MATCHER=true
